# 博客后端配置文件示例
# 复制此文件为 config.toml 并修改配置

[server]
port = "8080"
mode = "debug"  # debug, release, test
allowed_origins = []
rate_limit = 0
search_rate_limit = 0
enable_swagger = true
max_search_query_len = 100
moment_secret = ""  # optional shared secret for POST /api/v1/moments; use X-Moment-Secret; generate: openssl rand -base64 32

[database]
host = "localhost"
port = "5432"
user = "postgres"
password = "your_password_here"
name = "blog"
sslmode = "disable"

[jwt]
secret = ""  # required: set a real JWT secret before starting
access_duration = 15      # 分钟
refresh_duration = 10080  # 分钟 (7天)

[logging]
level = "info"      # trace, debug, info, warn, error, fatal, panic
env = "development" # development, production
output_file = ""
max_size = 0
max_backups = 0
max_age = 0
compress = false

[migration]
path = "migrations"

[admin]
username = "admin"
email = "admin@example.com"
password = ""  # required: set a strong admin password before starting
nickname = "博主"
avatar_url = ""
bio = "欢迎来到我的博客"
github = ""
bilibili = ""
x = ""

[github]
token = ""         # GitHub Personal Access Token
username = ""      # GitHub 用户名

[site]
base_url = "https://yourdomain.com"  # 站点完整 URL，用于生成 sitemap

[upload]
dir = "uploads"

[upload.imgbed]
endpoint = ""
token = ""
delete_endpoint = ""
delete_token = ""
field = "file"
upload_folder = "Blog"
